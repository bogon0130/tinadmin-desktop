{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tinadmin-desktop",
  "version": "0.56.0",
  "identifier": "com.bogon.tinadmin",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "tt++ 고블린 자반 프로그램 by Kim Bo Gon",
        "width": 1400,
        "height": 918,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/bogon0130/tinadmin-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFRjkwRUVEODcxMzlFNkMKUldSc25oT0g3UTc1SGw1bTN4Tnh3ZEJvdjlPTWtwRjZ0NEZmVHZHNVlKVXRGeXg3TnJmbitjSksK"
    }
  }
}
